# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# Sepolia RPC endpoint - READ ONLY use by the backend.
# Powers deploy preflight checks and /api/admin/reconcile (eth_call and
# eth_getBalance only). The backend never signs or sends a transaction.
# If unset, ALCHEMY_API_KEY below is used as a fallback.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Alchemy API Key (get from https://alchemy.com)
# Despite the name this holds a full RPC URL. Used by Hardhat, and as the
# fallback for SEPOLIA_RPC_URL above.
ALCHEMY_API_KEY=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Private Key for deploying CONTRACTS via Hardhat (WITHOUT 0x prefix).
# NOT used by the backend server, and must never be. Deploying CritCoin to
# students is signed in the admin's MetaMask, in the browser - there is no
# deployer key on the server. Do not set this in Railway.
SEPOLIA_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# MongoDB Connection String
# Create a new user with limited permissions for production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp

# Admin Wallet Address (with 0x prefix)
ADMIN_WALLET=0xYourAdminWalletAddressHere

# Session token signing secret (REQUIRED in production).
# Signs the HMAC session tokens issued after Sign-In With Ethereum. Use a long
# random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value logs everyone out (they re-sign on next action).
JWT_SECRET=generate_a_long_random_secret_here

# Production Environment
NODE_ENV=production

# Frontend URL for CORS (production)
FRONTEND_URL=https://your-frontend-domain.com